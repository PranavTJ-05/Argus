# Argus local development environment

# Runtime
NODE_ENV=development
LOG_LEVEL=debug

# API server
API_HOST=0.0.0.0
API_PORT=3001
# Local development fallback only. Production customer integrations should use
# workspace API keys created from the dashboard Setup panel.
API_KEY=dev_shared_api_key
API_RATE_LIMIT_MAX=60
API_RATE_LIMIT_WINDOW_MS=60000
API_REQUEST_BODY_LIMIT_BYTES=65536
API_CORS_ORIGIN=http://localhost:3000

# Auth bootstrap user
AUTH_BOOTSTRAP_EMAIL=owner@argus.local
AUTH_BOOTSTRAP_PASSWORD=replace_with_strong_password
AUTH_BOOTSTRAP_WORKSPACE_NAME=Argus Workspace
INTEGRATION_SECRET_KEY=replace_with_32_plus_char_secret

# Worker
WORKER_HOST=0.0.0.0
WORKER_PORT=3002

# Dashboard
NEXT_PUBLIC_API_URL=http://localhost:3001

# Database
DATABASE_URL=postgres://argus:argus@localhost:5432/argus

# Inngest
INNGEST_EVENT_KEY=local_event_key
INNGEST_SIGNING_KEY=local_signing_key
INNGEST_BASE_URL=http://localhost:8288

# LLM provider
ANTHROPIC_API_KEY=replace_with_real_key

# Model aliases
MODEL_DIRECTOR_PRIMARY=claude-sonnet-4-6
MODEL_EXPERT_CHEAP=claude-haiku-4-5-20251001
MODEL_CRITIC_BALANCED=claude-sonnet-4-6
MODEL_COUNSEL_BALANCED=claude-sonnet-4-6
MODEL_REPORTER_PRIMARY=claude-sonnet-4-6

# Legacy local/global integration defaults. Production launch workspaces should
# configure integrations from the dashboard Setup panel.
TEMPO_ENDPOINT=http://localhost:3200
LOKI_ENDPOINT=http://localhost:3100
PROMETHEUS_ENDPOINT=http://localhost:9090
GRAFANA_ENDPOINT=http://localhost:3000

# Deploy/code integrations
GITHUB_TOKEN=replace_with_dev_token
GITHUB_OWNER=replace_with_owner
GITHUB_REPO=replace_with_repo

# Optional feature flag backend
LAUNCHDARKLY_API_TOKEN=replace_with_dev_token

# OpenTelemetry
OTEL_SERVICE_NAME=argus
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_TRACES_EXPORTER=otlp
OTEL_METRICS_EXPORTER=otlp
OTEL_LOGS_EXPORTER=otlp
