{
  "name": "argus",
  "version": "0.0.0",
  "author": "PranavTJ-05",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.0.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo run build",
    "check": "turbo run check",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "eval:smoke": "pnpm --filter @argus/evals eval:smoke",
    "eval:full": "pnpm --filter @argus/evals eval:full",
    "smoke:v1": "node scripts/smoke-v1.mjs",
    "smoke:launch": "node scripts/smoke-launch.mjs",
    "demo:v1": "node scripts/demo-v1.mjs",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "db:up": "docker compose -f infra/docker-compose.yml up -d postgres",
    "db:down": "docker compose -f infra/docker-compose.yml down",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "clean": "turbo run clean"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@types/node": "^22.10.2",
    "drizzle-kit": "^0.31.11",
    "postgres": "^3.4.5",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
